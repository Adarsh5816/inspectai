{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentExtractionSchema",
  "description": "Schema for structured data extracted from RFI, ITP, and Calibration documents with complete provenance",
  "type": "object",
  "required": [
    "document_type",
    "document_metadata",
    "extracted_fields"
  ],
  "properties": {
    "document_type": {
      "type": "string",
      "enum": [
        "RFI",
        "ITP",
        "DATASHEET",
        "GAD",
        "FAT_PROCEDURE",
        "TEST_PROCEDURE",
        "CALIBRATION_CERTIFICATE",
        "MATERIAL_CERTIFICATE",
        "INSPECTION_REPORT",
        "OTHER"
      ]
    },
    "classification_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "document_metadata": {
      "type": "object",
      "properties": {
        "document_number": { "type": ["string", "null"] },
        "revision": { "type": ["string", "null"] },
        "document_title": { "type": ["string", "null"] },
        "document_date": { "type": ["string", "null"] },
        "total_pages": { "type": "integer" }
      },
      "required": ["total_pages"]
    },
    "extracted_fields": {
      "type": "object",
      "properties": {
        "project": {
          "type": "object",
          "properties": {
            "project_number": { "$ref": "#/definitions/ProvenanceString" },
            "project_name": { "$ref": "#/definitions/ProvenanceString" },
            "customer_name": { "$ref": "#/definitions/ProvenanceString" },
            "epc_contractor": { "$ref": "#/definitions/ProvenanceString" },
            "supplier_name": { "$ref": "#/definitions/ProvenanceString" },
            "supplier_address": { "$ref": "#/definitions/ProvenanceString" },
            "sub_supplier_name": { "$ref": "#/definitions/ProvenanceString" },
            "po_number": { "$ref": "#/definitions/ProvenanceString" }
          }
        },
        "rfi_details": {
          "type": "object",
          "properties": {
            "rfi_number": { "$ref": "#/definitions/ProvenanceString" },
            "rfi_revision": { "$ref": "#/definitions/ProvenanceString" },
            "itp_reference": { "$ref": "#/definitions/ProvenanceString" },
            "inspection_location": { "$ref": "#/definitions/ProvenanceString" },
            "inspection_dates": {
              "type": "array",
              "items": { "type": "string" }
            },
            "contact_persons": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "role": { "type": "string" },
                  "phone": { "type": ["string", "null"] },
                  "email": { "type": ["string", "null"] }
                },
                "required": ["name"]
              }
            },
            "requested_activities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "clause": { "type": "string" },
                  "description": { "type": "string" },
                  "dates": { "type": ["string", "null"] },
                  "tpi_intervention": { "type": ["string", "null"] },
                  "arco_intervention": { "type": ["string", "null"] },
                  "adnoc_intervention": { "type": ["string", "null"] }
                },
                "required": ["clause", "description"]
              }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "po_item_no": { "type": "string" },
                  "tag_no": { "type": "string" },
                  "serial_no": { "type": "string" },
                  "job_no": { "type": ["string", "null"] },
                  "details": { "type": "string" },
                  "quantity": { "type": "integer" }
                },
                "required": ["po_item_no", "tag_no", "serial_no"]
              }
            }
          }
        },
        "itp_details": {
          "type": "object",
          "properties": {
            "itp_number": { "$ref": "#/definitions/ProvenanceString" },
            "revision": { "$ref": "#/definitions/ProvenanceString" },
            "originator_doc_no": { "$ref": "#/definitions/ProvenanceString" },
            "reference_documents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "document_number": { "type": "string" },
                  "title": { "type": "string" }
                }
              }
            },
            "activities": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "act_no": { "type": "string" },
                  "activity_description": { "type": "string" },
                  "extent_of_examination": { "type": "string" },
                  "reference_document": { "type": "string" },
                  "acceptance_criteria": { "type": "string" },
                  "verifying_document": { "type": "string" },
                  "quality_intervention": {
                    "type": "object",
                    "properties": {
                      "sub_vendor": { "type": ["string", "null"] },
                      "ksb": { "type": ["string", "null"] },
                      "tpia": { "type": ["string", "null"] },
                      "archirodon": { "type": ["string", "null"] },
                      "adnoc": { "type": ["string", "null"] }
                    }
                  },
                  "inspection_level": { "type": ["string", "null"] }
                },
                "required": ["act_no", "activity_description", "acceptance_criteria"]
              }
            },
            "annexure_valves": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "item_no": { "type": "integer" },
                  "tag_no": { "type": "string" },
                  "series": { "type": "string" },
                  "size_inch": { "type": "string" },
                  "material": { "type": "string" },
                  "rating": { "type": "string" },
                  "area": { "type": "string" }
                },
                "required": ["tag_no"]
              }
            }
          }
        },
        "calibration_details": {
          "type": "object",
          "properties": {
            "instrument_name": { "$ref": "#/definitions/ProvenanceString" },
            "manufacturer": { "$ref": "#/definitions/ProvenanceString" },
            "serial_number": { "$ref": "#/definitions/ProvenanceString" },
            "certificate_number": { "$ref": "#/definitions/ProvenanceString" },
            "calibration_date": { "$ref": "#/definitions/ProvenanceString" },
            "expiry_date": { "$ref": "#/definitions/ProvenanceString" },
            "range": { "$ref": "#/definitions/ProvenanceString" },
            "accuracy": { "$ref": "#/definitions/ProvenanceString" }
          }
        }
      }
    }
  },
  "definitions": {
    "ProvenanceString": {
      "type": "object",
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source_document": { "type": "string" },
        "page": { "type": "integer" }
      },
      "required": ["value", "confidence", "source_document", "page"]
    }
  }
}
