# Uploaded storage files (keep directories via .gitkeep)
storage/*.docx
storage/documents/*
!storage/documents/.gitkeep
storage/photos/*
!storage/photos/.gitkeep
storage/reports/*
!storage/reports/.gitkeep

# Logs and OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
