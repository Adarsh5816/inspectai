# Dependencies
node_modules/
**/node_modules/

# Production build outputs
dist/
**/dist/

# Environment and secrets
.env
**/.env
.env.local
.env.*.local
*.env

# SQLite local databases
*.db
*.db-journal
server/dev.db
server/dev.db-journal
server/prisma/*.db
